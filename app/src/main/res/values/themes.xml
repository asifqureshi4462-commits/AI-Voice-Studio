<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AIVoiceStudio" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/brand_cyan</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorPrimaryContainer">@color/bg_card_elevated</item>
        <item name="colorOnPrimaryContainer">@color/brand_cyan</item>
        
        <item name="colorSecondary">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/bg_card_elevated</item>
        <item name="colorOnSecondaryContainer">@color/brand_violet</item>
        
        <!-- Background & Surface Colors -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        
        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        
        <!-- Component Theming -->
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
        <item name="cardViewStyle">@style/Widget.AIVoiceStudio.CardView</item>
    </style>

    <!-- Legacy / Alias for default theme -->
    <style name="Theme.MyApplication" parent="Theme.AIVoiceStudio" />

    <!-- Card Styles -->
    <style name="Widget.AIVoiceStudio.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AIVoiceStudio.ElevatedCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card_elevated</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.AIVoiceStudio.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/brand_cyan</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="iconTint">@color/bg_dark</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="Widget.AIVoiceStudio.SecondaryButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/bg_card_elevated</item>
        <item name="android:textColor">@color/brand_cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/brand_cyan</item>
    </style>

    <style name="Widget.AIVoiceStudio.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <!-- Bottom Sheet Theme -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

</resources>
