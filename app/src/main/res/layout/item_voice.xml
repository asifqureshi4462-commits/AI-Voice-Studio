<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar / Icon -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:id="@+id/ivVoiceIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wave"
                    app:tint="@color/brand_cyan"
                    android:contentDescription="Voice Avatar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVoiceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rachel"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVoiceDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="American • Female • Conversational"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Favorite button -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_heart"
                android:contentDescription="Favorite Voice" />

            <!-- Preview Audio button -->
            <ImageButton
                android:id="@+id/btnPreview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_icon"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/brand_cyan"
                android:contentDescription="Preview Voice" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvVoiceDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Calm, natural, and friendly. Great for casual conversation and explainers."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Select voice action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectVoice"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/bg_card_elevated"
            android:text="@string/voices_use_voice"
            android:textColor="@color/brand_cyan"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/stroke_subtle"
            app:strokeWidth="1dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
